# muni가 반드시 필요로 하는 런타임 환경변수는 아래 4개입니다.
POSTGRES_DSN=postgres://muni:change-me@postgres.internal:5432/muni?sslmode=require
BOOTSTRAP_ADMIN=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
# openssl rand -base64 32
ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# 선택: PDF 내보내기 동작 조정
# MUNI_CHROMIUM_PATH=/usr/bin/chromium
# MUNI_PDF_CONCURRENCY=2
